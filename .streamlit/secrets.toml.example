# Copy this file to .streamlit/secrets.toml and fill in real values.
# secrets.toml is in .gitignore and will NEVER be committed to GitHub.
#
# On Streamlit Community Cloud, enter these same key=value pairs
# in the app Settings → Secrets dashboard instead of using this file.

ANTHROPIC_API_KEY = "sk-ant-api03-..."
TAVILY_API_KEY    = "tvly-..."
APP_PASSWORD      = "choose-a-strong-demo-password"
